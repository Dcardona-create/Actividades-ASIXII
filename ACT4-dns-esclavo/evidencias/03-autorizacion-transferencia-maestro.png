でしょうか？","aria-label":"Claudeへのプロンプトを入力してください"},"es-419":{"greeting":"¡Aquí estás!","placeholder":"¿Cómo puedo ayudarte hoy?","aria-label":"Escribe tu mensaje para Claude"},"es-ES":{"greeting":"¡Ya estás aquí!","placeholder":"¿En qué puedo ayudarte hoy?","aria-label":"Escriba su consulta para Claude"},"it-IT":{"greeting":"Eccoti!","placeholder":"Come posso aiutarti oggi?","aria-label":"Scrivi il tuo prompt per Claude"},"hi-IN":{"greeting":"नमस्ते!","placeholder":"आज मैं आपकी कैसे मदद कर सकता/सकती हूं?","aria-label":"Claude को अपना प्रॉम्प्ट लिखें"},"pt-BR":{"greeting":"Que bom ter você aqui!","placeholder":"Como posso ajudar você hoje?","aria-label":"Escreva as instruções para o Claude"},"id-ID":{"greeting":"Halo, kamu!","placeholder":"Ada yang bisa saya bantu hari ini?","aria-label":"Tulis prompt Anda ke Claude"},"am":{"greeting":"እንኳን ደህና መጡ!","placeholder":"ዛሬ እንዴት ልረዳዎት እችላለሁ?","aria-label":"ለClaude ፕሮምፕትዎን ይጻፉ"},"bho":{"greeting":"रउआ आ गइनी!","placeholder":"आज हम रउआ के कइसे मदद कर सकीले?","aria-label":"Claude खातिर आपन प्रॉम्प्ट लिखीं"},"bn":{"greeting":"এসে গেছেন!","placeholder":"আজ আমি আপনাকে কীভাবে সাহায্য করতে পারি?","aria-label":"Claude-এর জন্য আপনার প্রম্পট লিখুন"},"da":{"greeting":"Dejligt at se dig!","placeholder":"Hvordan kan jeg hjælpe dig i dag?","aria-label":"Skriv din prompt til Claude"},"fi":{"greeting":"Mukava nähdä!","placeholder":"Miten voin auttaa sinua tänään?","aria-label":"Kirjoita kehotteesi Claudelle"},"fil":{"greeting":"Nandito ka na!","placeholder":"Paano kita matutulungan ngayon?","aria-label":"Isulat ang iyong prompt sa Claude"},"gu":{"greeting":"તમે આવી ગયા!","placeholder":"આજે હું તમને કેવી રીતે મદદ કરી શકું?","aria-label":"Claude માટે તમારો પ્રોમ્પ્ટ લખો"},"ha":{"greeting":"Barka da zuwa!","placeholder":"Ta yaya zan iya taimaka maka a yau?","aria-label":"Rubuta saƙonka zuwa ga Claude"},"ig":{"greeting":"Nnọọ!","placeholder":"Kedu ka m ga-esi nyere gị aka taa?","aria-label":"Dee ozi gị nye Claude"},"kn":{"greeting":"ನೀವು ಬಂದಿದ್ದೀರಿ!","placeholder":"ಇಂದು ನಿಮಗೆ ಹೇಗೆ ಸಹಾಯ ಮಾಡಲಿ?","aria-label":"Claude ಗೆ ನಿಮ್ಮ ಪ್ರಾಂಪ್ಟ್ ಬರೆಯಿರಿ"},"ml":{"greeting":"നിങ്ങൾ എത്തിയല്ലോ!","placeholder":"ഇന്ന് ഞാൻ നിങ്ങളെ എങ്ങനെ സഹായിക്കണം?","aria-label":"Claude-ന് നിങ്ങളുടെ പ്രോംപ്റ്റ് എഴുതുക"},"mr":{"greeting":"तुम्ही आलात!","placeholder":"आज मी तुम्हाला कशी मदत करू?","aria-label":"Claude साठी तुमचा प्रॉम्प्ट लिहा"},"nb":{"greeting":"Der er du!","placeholder":"Hva kan jeg hjelpe deg med i dag?","aria-label":"Skriv ledeteksten din til Claude"},"nl":{"greeting":"Fijn dat je er bent!","placeholder":"Waarmee kan ik je vandaag helpen?","aria-label":"Schrijf je prompt voor Claude"},"ny":{"greeting":"Mwafika!","placeholder":"Ndingakuthandizeni bwanji lero?","aria-label":"Lembani uthenga wanu kwa Claude"},"om":{"greeting":"Baga nagaan dhufte!","placeholder":"Har'a maal si gargaaruu danda'a?","aria-label":"Ergaa kee Claude-f barreessi"},"pt-PT":{"greeting":"Que bom ver-te!","placeholder":"Como te posso ajudar hoje?","aria-label":"Escreve o teu prompt para o Claude"},"rn":{"greeting":"Kaze!","placeholder":"Nokugira iki uyu musi?","aria-label":"Andika ubutumwa bwawe ushaka kurungikira Claude"},"ru":{"greeting":"Рады вас видеть!","placeholder":"Чем я могу вам помочь сегодня?","aria-label":"Напишите запрос для Claude"},"rw":{"greeting":"Uraho!","placeholder":"Nagufasha iki uyu munsi?","aria-label":"Andika ubutumwa bwawe kuri Claude"},"so":{"greeting":"Waad timid!","placeholder":"Sidee kuu caawin karaa maanta?","aria-label":"Qor farriintaada aad u dirayso Claude"},"sv":{"greeting":"Kul att du är här!","placeholder":"Hur kan jag hjälpa dig i dag?","aria-label":"Skriv din prompt till Claude"},"sw":{"greeting":"Umefika!","placeholder":"Nikusaidie nini leo?","aria-label":"Andika ombi lako kwa Claude"},"ta":{"greeting":"வாருங்கள்!","placeholder":"இன்று நான் உங்களுக்கு எப்படி உதவலாம்?","aria-label":"Claude-க்கு உங்கள் ப்ராம்ப்டை எழுதவும்"},"te":{"greeting":"మీరు వచ్చేశారు!","placeholder":"ఈ రోజు నేను మీకు ఎలా సహాయపడగలను?","aria-label":"